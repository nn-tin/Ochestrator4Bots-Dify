# Qwen (required)
QWEN_BASE_URL=https://aistudio.motivesfareast.com/ai-api/idp_llm/v1
QWEN_BEARER=
QWEN_MODEL=qwen36
QWEN_MAX_TOKENS=512
QWEN_TIMEOUT_SECONDS=30

# Dify
DIFY_BASE_URL=https://aistudio.motivesfareast.com/dify/v1
DIFY_LATE_REQUEST_API_KEY=
DIFY_LEAVE_REQUEST_API_KEY=
DIFY_IT_HELPDESK_API_KEY=
DIFY_MEETING_BOOKING_API_KEY=

# MongoDB settings used by the app outside Docker
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=orchestrator
MONGODB_COLLECTION=conversations
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Docker Compose settings
APP_PORT=8000
MONGO_PORT=27017
MONGO_ROOT_USERNAME=orchestrator
MONGO_ROOT_PASSWORD=orchestrator-dev-password
